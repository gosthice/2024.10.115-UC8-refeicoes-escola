{
  "name": "controle_refeicao_escolar",
  "version": "1.0.0",
  "description": "Atividade prática da aula de autenticação.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js --watch",
    "db:migrate": "npx sequelize db:migrate",
    "db:migrate:undo": "npx sequelize db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize db:migrate:undo:all",
    "db:seed": "npx sequelize db:seed:all",
    "db:seed:undo": "npx sequelize db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:fresh": "npm run db:migrate:undo:all && npm run db:migrate",
    "db:status": "npx sequelize db:migrate:status",
    "db:setup": "node scripts/setup-database.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rai-sys/controle_refeicao_escolar.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rai-sys/controle_refeicao_escolar/issues"
  },
  "homepage": "https://github.com/Rai-sys/controle_refeicao_escolar#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
